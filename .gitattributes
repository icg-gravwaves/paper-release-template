# Git LFS: binary data products are stored in LFS rather than directly in
# git, so that each new version does not permanently grow the repository.
# Track by extension and directory rather than by individual file name, so
# new files are caught automatically. Run `git lfs track` or edit this file
# to add patterns, and commit it before adding the matching files.
data/raw/** filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.hdf filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.hdf5 filter=lfs diff=lfs merge=lfs -text
*.fits filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
